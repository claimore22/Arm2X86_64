/// UDIV (Unsigned Divide) semantics are representable in the IR.
use semantic_ir::{
    BitWidth, Expr, Instruction, InstructionId, Provenance, Reg, Stmt, ValueType, Width,
    validate_instruction,
};

fn udiv_instruction() -> Instruction {
    let datasize = Width::Fixed(BitWidth::W64);

    let operand1 = Expr::ReadReg {
        reg: Reg::X(2),
        width: BitWidth::W64,
    };

    let operand2 = Expr::ReadReg {
        reg: Reg::X(3),
        width: BitWidth::W64,
    };

    // UDIV: result = UInt(operand1) / UInt(operand2), or 0 if divisor == 0
    // We model this as a conditional expression
    let is_zero = Expr::Binary {
        op: semantic_ir::BinOp::Eq,
        left: Box::new(operand2.clone()),
        right: Box::new(Expr::Const {
            value: 0,
            ty: BitWidth::W64,
        }),
        ty: ValueType::Bool,
    };

    let div_result = Expr::Binary {
        op: semantic_ir::BinOp::Div,
        left: Box::new(operand1),
        right: Box::new(operand2),
        ty: ValueType::Bits(Width::Fixed(BitWidth::W64)),
    };

    let result = Expr::Select {
        condition: Box::new(is_zero),
        when_true: Box::new(Expr::Const {
            value: 0,
            ty: BitWidth::W64,
        }),
        when_false: Box::new(div_result),
        ty: ValueType::Bits(Width::Fixed(BitWidth::W64)),
    };

    let semantics = vec![Stmt::WriteReg {
        reg: Reg::X(1),
        value: result,
    }];

    Instruction {
        id: InstructionId {
            mnemonic: "UDIV".to_string(),
            encoding: Some("Unsigned divide".to_string()),
        },
        operands: Vec::new(),
        required_features: Vec::new(),
        decode: None,
        semantics,
        provenance: Provenance {
            source_path: "udiv.md".to_string(),
            source_sha256: "test-source-sha256".to_string(),
            clean_sha256: "test-clean-sha256".to_string(),
        },
    }
}

#[test]
fn udiv_validates() {
    let instruction = udiv_instruction();

    validate_instruction(&instruction).expect("UDIV should validate");
}

#[test]
fn udiv_uses_select_for_divide_by_zero() {
    let instruction = udiv_instruction();

    assert_eq!(instruction.semantics.len(), 1);

    let Stmt::WriteReg { value, .. } = &instruction.semantics[0] else {
        panic!("expected WriteReg");
    };

    let Expr::Select { condition, when_true, when_false, .. } = value else {
        panic!("expected Select for divide by zero handling");
    };

    // Condition: operand2 == 0
    let Expr::Binary { op, left, right, .. } = condition.as_ref() else {
        panic!("expected Binary Eq for condition");
    };

    assert_eq!(*op, semantic_ir::BinOp::Eq);
    assert!(matches!(left.as_ref(), Expr::ReadReg { reg: Reg::X(3), .. }));
    assert!(matches!(right.as_ref(), Expr::Const { value: 0, .. }));

    // when_true = 0
    assert!(matches!(when_true.as_ref(), Expr::Const { value: 0, .. }));

    // when_false = operand1 / operand2
    let Expr::Binary { op, left, right, .. } = when_false.as_ref() else {
        panic!("expected Binary Div for division");
    };

    assert_eq!(*op, semantic_ir::BinOp::Div);
    assert!(matches!(left.as_ref(), Expr::ReadReg { reg: Reg::X(2), .. }));
    assert!(matches!(right.as_ref(), Expr::ReadReg { reg: Reg::X(3), .. }));
}